{
  "name": "flowmusic",
  "version": "2.0.0",
  "description": "flowmusic",
  "main": "electron/main.js",
  "author": "xeenjair",
  "scripts": {
    "start": "electron .",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:8080 && set NODE_ENV=development && electron .\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.flowmusic.app",
    "productName": "Flowmusic",
    "copyright": "Copyright © 2024",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/**/*.{md,ts,map}",
      "!node_modules/**/test/**",
      "!**/*.ts",
      "!**/*.map",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "portable": {
      "artifactName": "Flowmusic"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0",
    "framer-motion": "^10.16.0",
    "node-html-parser": "^6.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "concurrently": "^8.2.0",
    "css-loader": "^6.8.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}